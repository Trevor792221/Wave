<?xml version="1.0" encoding="utf-8"?>
<!-- Wave Mobile: a media app for Android Auto (named "Wave", like the TV app). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The media notification (Android 13+ asks before showing notifications). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Which network is in use, for the separate Wi-Fi and mobile data audio quality. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional, granted only over ADB (adb shell pm grant com.wave.mobile android.permission.DUMP):
         the signal-path panel then reads Android's audio and Bluetooth reports (real output format,
         sound effects switched on, Bluetooth codec). Without it the panel shows the basics. -->
    <uses-permission android:name="android.permission.DUMP" tools:ignore="ProtectedPermissions" />
    <!-- iAdb's own permission: how iAdb finds the apps to hand its connection to (IadbGrant). Its
         Allow / Deny prompt is what actually lets Wave use it. -->
    <uses-permission android:name="com.iadb.helper.permission.API" />
    <!-- To read Android Auto's connection state (for playing on by itself when the car connects). -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <provider android:authorities="androidx.car.app.connection" />
        <!-- iAdb (ADB on the phone itself), for the one-tap DUMP grant. -->
        <package android:name="com.iadb.helper" />
    </queries>
    <application>
        <meta-data android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Satellite data (T-Mobile's T-Satellite and others, Android 15+): Android only lets apps
             that say they're satellite-ready use it. There Wave turns on Tidal's adaptive streaming. -->
        <meta-data android:name="android.telephony.PROPERTY_SATELLITE_DATA_OPTIMIZED"
            android:value="${applicationId}" />
        <!-- S Pen Air actions: press once to play or pause, twice for the next song (res/xml/spen_actions.xml). -->
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="com.samsung.android.support.REMOTE_ACTION" />
            </intent-filter>
            <meta-data android:name="com.samsung.android.support.REMOTE_ACTION"
                android:resource="@xml/spen_actions" />
        </activity>
        <!-- Where iAdb hands over its connection (IadbGrant). Only iAdb's server, running as the
             shell, can call it (INTERACT_ACROSS_USERS_FULL is a permission the shell has). -->
        <provider android:name=".IadbGrant$Provider"
            android:authorities="${applicationId}.iadb"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:exported="true"
            android:multiprocess="false"
            android:enabled="true" />
        <!-- Settings backup (the Updates tab): Android runs it on the schedule picked there. -->
        <service android:name=".Backup$Job" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service android:name=".WaveMediaService" android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
